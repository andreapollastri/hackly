APP_NAME=Hackly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Prefix on Sanctum personal access tokens (shown once, then stored hashed).
SANCTUM_TOKEN_PREFIX=hk_

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hackly
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1020
HACKLY_JOB_TIMEOUT=960

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Hackly scanner settings
HACKLY_ALLOWLIST_ONLY=false
HACKLY_ALLOWLIST=
HACKLY_ALLOW_PRIVATE_TARGETS=true
HACKLY_PER_TARGET_PER_MINUTE=2
HACKLY_GLOBAL_CONCURRENT=5
HACKLY_JITTER_SECONDS=5
HACKLY_TASK_SPACING_SECONDS=10
HACKLY_DEEP_COOLDOWN_HOURS=24
HACKLY_QUIET_HOURS_ENABLED=false
HACKLY_QUIET_HOURS_START=0
HACKLY_QUIET_HOURS_END=6
HACKLY_QUIET_HOURS_TZ=UTC
HACKLY_NMAP=nmap
HACKLY_NMAP_TIMEOUT=840
HACKLY_NMAP_TOP_PORTS=50
HACKLY_NMAP_TIMING=T3
HACKLY_NMAP_DELAY_MS=100
HACKLY_DIG=dig
HACKLY_WHOIS=whois
HACKLY_NUCLEI=nuclei
HACKLY_WPSCAN=wpscan
HACKLY_NIKTO=nikto
# Optional. WPScan vulnerability data needs a free token from wpscan.com.
# HACKLY_WPSCAN_API_TOKEN=
# Address shown on DNS setup so it can be allowlisted. Empty = detect it once.
# HACKLY_EGRESS_IP=
# Fresh TXT lifetime and cooldown for penetration tests.
# HACKLY_PENTEST_AUTH_MINUTES=30
# HACKLY_PENTEST_COOLDOWN_HOURS=6
# Writable dir for nuclei config/cache/templates (queue worker HOME)
# HACKLY_NUCLEI_HOME=/var/www/hackly/storage/app/nuclei-home
# HACKLY_NUCLEI_TEMPLATES=/var/www/hackly/storage/app/nuclei-home/nuclei-templates
# macOS app install example:
# HACKLY_ZAP=/Applications/ZAP.app/Contents/Java/zap.sh
HACKLY_ZAP=zap.sh
HACKLY_NUCLEI_RATE_LIMIT=30
HACKLY_NUCLEI_CONCURRENCY=5
# HACKLY_NUCLEI_TAGS=owasp,cve,misconfig,exposure,vuln,laravel,php,dotenv
# HACKLY_PATH_TAGS=discovery,exposure,config,laravel,php,dotenv
# HACKLY_PATH_MAX_PATHS=80
# HACKLY_TECH_FINGERPRINT_TIMEOUT=60

# GitHub repository scanning (install tools: sudo bash scripts/install-repo-scanners.sh)
HACKLY_GIT=git
HACKLY_COMPOSER=composer
HACKLY_SEMGREP=semgrep
HACKLY_TRIVY=trivy
HACKLY_GITLEAKS=gitleaks
HACKLY_CHECKOV=checkov
# Extra dirs for PHP/queue PATH (pipx etc.): /root/.local/bin,/home/cipi/.local/bin
# HACKLY_BINARY_SEARCH_DIRS=
# Or pin absolute paths:
# HACKLY_SEMGREP=/root/.local/bin/semgrep
# HACKLY_SEMGREP_CONFIG=p/php
# HACKLY_OSV_ENABLED=true
# HACKLY_CHECKPOINT_TIMEOUT=600
# HACKLY_REPO_HIDE_UNREACHABLE=false
# HACKLY_REPO_DROP_NOISE=false

# Sunday findings digest. The scheduler must be running (schedule:work or cron).
HACKLY_DIGEST_ENABLED=true
HACKLY_DIGEST_TIME=08:00
# HACKLY_DIGEST_TIMEZONE=Europe/Rome

# Daily refresh of Nuclei templates, Trivy DB, and Semgrep rules.
HACKLY_DB_UPDATE_ENABLED=true
HACKLY_DB_UPDATE_TIME=03:30
# HACKLY_DB_UPDATE_TIMEZONE=Europe/Rome
# HACKLY_TRIVY_CACHE=
# HACKLY_SEMGREP_HOME=

# Self-update (Settings → Updates). The scheduler must be running (cron schedule:run).
# APP_UPDATES=true
# APP_UPDATE_REPOSITORY=https://github.com/andreapollastri/hackly.git
# APP_UPDATE_CHANNEL=stable
# APP_UPDATE_AUTO=true
# APP_UPDATE_TIME=04:00
# APP_UPDATE_BACKUP=true
# Empty: found on the PATH of the scheduler's user.
# APP_UPDATE_PHP=
# APP_UPDATE_COMPOSER=
